# ── CI Docker image ───────────────────────────────────────────────────────────
# Uses pre-built binaries from the release workflow instead of compiling from
# source, which avoids slow QEMU-emulated Rust compilation for arm64.
FROM alpine:3.20
ARG TARGETARCH

RUN apk add --no-cache ca-certificates

COPY dist/merlin-linux-${TARGETARCH} /usr/local/bin/merlin
RUN chmod +x /usr/local/bin/merlin

ENTRYPOINT ["/usr/local/bin/merlin"]
CMD ["review"]
