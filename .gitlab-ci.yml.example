# Merlin AI Code Review — GitLab CI example
# Copy the relevant job(s) into your .gitlab-ci.yml
#
# Secrets to add in GitLab → Settings → CI/CD → Variables:
#   ANTHROPIC_API_KEY  — your Anthropic key (or OPENAI_API_KEY)

stages:
  - review

# ── Merge request review (Docker — recommended) ───────────────────────────────
# Uses the public GHCR image — no download step needed.
#
# RAG index (merlin-rag.jsonl) is cached per-branch so Merlin has codebase
# context without re-indexing on every run. The first pipeline run on a branch
# builds the index; subsequent runs load it from cache (fast + no extra tokens).

merlin-review:
  stage: review
  image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest

  # Cache the RAG index — persists the vector store across pipeline runs.
  # Without this every run starts with no codebase context.
  cache:
    key: merlin-rag-$CI_DEFAULT_BRANCH
    paths:
      - merlin-rag.jsonl

  script:
    - merlin review

  variables:
    GITLAB_TOKEN: $CI_JOB_TOKEN          # provided automatically — no secret needed
    ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
    # Uncomment for OpenAI instead:
    # OPENAI_API_KEY: $OPENAI_API_KEY
    # Point Merlin at the cached index file (matches the cache path above):
    MERLIN_RAG_LOCAL_PATH: merlin-rag.jsonl

  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ── Alternative: install-script (no Docker) ───────────────────────────────────
# Use this if your runner cannot pull from GHCR.
# The musl binary is fully static — works on any Linux without glibc.
#
# merlin-review:
#   stage: review
#   image: alpine:3.20
#
#   cache:
#     - key: merlin-binary-$CI_RUNNER_ID
#       paths:
#         - .merlin/
#     - key: merlin-rag-$CI_DEFAULT_BRANCH
#       paths:
#         - merlin-rag.jsonl
#
#   before_script:
#     - apk add --no-cache curl ca-certificates
#
#   script:
#     - |
#       if [ ! -x .merlin/merlin ]; then
#         mkdir -p .merlin
#         curl -fsSL \
#           https://github.com/Arunachalamkalimuthu/merlin-ai-code-review/releases/latest/download/install.sh \
#           | MERLIN_INSTALL_DIR=.merlin sh
#       fi
#     - .merlin/merlin review
#
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     MERLIN_RAG_LOCAL_PATH: merlin-rag.jsonl
#
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ── Optional: nightly re-index ────────────────────────────────────────────────
# Run a full codebase re-index on a schedule so the RAG cache stays fresh.
# Trigger from GitLab → CI/CD → Schedules (e.g. daily at midnight).
#
# merlin-index:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   cache:
#     key: merlin-rag-$CI_DEFAULT_BRANCH
#     paths:
#       - merlin-rag.jsonl
#   script:
#     - merlin index --path .
#   variables:
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     MERLIN_RAG_LOCAL_PATH: merlin-rag.jsonl
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "schedule"

# ── Optional: bot webhook mode ────────────────────────────────────────────────
# Uncomment to run a persistent webhook server that responds to @merlin comments.
#
# merlin-bot:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   script:
#     - merlin webhook --port 8080
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     MERLIN_GITLAB_SECRET: $MERLIN_GITLAB_SECRET   # webhook signing secret
#   rules:
#     - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
