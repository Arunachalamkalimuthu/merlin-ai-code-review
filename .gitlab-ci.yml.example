# Merlin AI Code Review — GitLab CI example
# Copy the relevant job(s) into your .gitlab-ci.yml
#
# Secrets to add in GitLab → Settings → CI/CD → Variables:
#   ANTHROPIC_API_KEY  — your Anthropic key (or OPENAI_API_KEY)

stages:
  - review

# ── Merge request review ──────────────────────────────────────────────────────

merlin-review:
  stage: review
  image: alpine:3.20

  # Cache the binary across pipeline runs — avoids downloading every time
  cache:
    key: merlin-binary-$CI_RUNNER_ID
    paths:
      - .merlin/

  before_script:
    - apk add --no-cache curl ca-certificates

  script:
    - |
      # Install merlin if not already cached
      if [ ! -x .merlin/merlin ]; then
        mkdir -p .merlin
        # musl binary = fully static, works on Alpine without glibc
        curl -fsSL \
          https://github.com/Arunachalamkalimuthu/merlin-ai-code-review/releases/latest/download/install.sh \
          | MERLIN_INSTALL_DIR=.merlin sh
      fi
    - .merlin/merlin review

  variables:
    GITLAB_TOKEN: $CI_JOB_TOKEN          # provided automatically — no secret needed
    ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
    # Uncomment for OpenAI instead:
    # OPENAI_API_KEY: $OPENAI_API_KEY

  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ── Optional: bot webhook mode ────────────────────────────────────────────────
# Uncomment to run a persistent webhook server that responds to @merlin comments.
#
