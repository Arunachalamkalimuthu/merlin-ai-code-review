# Merlin AI Code Review — GitLab CI example
# Copy the relevant job(s) into your .gitlab-ci.yml
#
# Secrets to add in GitLab → Settings → CI/CD → Variables:
#   ANTHROPIC_API_KEY  — Anthropic Claude (or swap for OPENAI_API_KEY / GEMINI_API_KEY)
#
# RAG embedding + vector store combinations — pick one section below:
#   A) OpenAI embeddings  + local JSONL cache  (recommended for most teams)
#   B) OpenAI embeddings  + Qdrant             (self-hosted, production)
#   C) OpenAI embeddings  + Pinecone           (managed cloud, zero ops)
#   D) Ollama embeddings  + local JSONL        (fully private, free — needs Ollama service)
#   E) No RAG             (fastest, no setup)

stages:
  - review

# ════════════════════════════════════════════════════════════════════════════════
# A) OpenAI embeddings + local JSONL (recommended)
# ════════════════════════════════════════════════════════════════════════════════
# Requires: OPENAI_API_KEY CI variable
# merlin.toml in repo root:
#   [rag]
#   enabled   = true
#   embedder  = "openai"
#   store     = "local"
#   local_path = "merlin-rag.jsonl"

merlin-review:
  stage: review
  image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest

  cache:
    key: merlin-rag-$CI_DEFAULT_BRANCH
    paths:
      - merlin-rag.jsonl       # persist the vector store across pipeline runs

  script:
    - merlin review

  variables:
    GITLAB_TOKEN: $CI_JOB_TOKEN
    ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
    OPENAI_API_KEY: $OPENAI_API_KEY    # used by the OpenAI embedder

  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ════════════════════════════════════════════════════════════════════════════════
# B) OpenAI embeddings + Qdrant (self-hosted)
# ════════════════════════════════════════════════════════════════════════════════
# No JSONL cache needed — index lives in Qdrant between runs.
# merlin.toml in repo root:
#   [rag]
#   enabled    = true
#   embedder   = "openai"
#   store      = "qdrant"
#   qdrant_url = "http://qdrant:6333"   # service hostname below
#
# services:
#   - name: qdrant/qdrant
#     alias: qdrant
#
# merlin-review:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   services:
#     - name: qdrant/qdrant
#       alias: qdrant
#   script:
#     - merlin review
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     OPENAI_API_KEY: $OPENAI_API_KEY
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ════════════════════════════════════════════════════════════════════════════════
# C) OpenAI embeddings + Pinecone (managed cloud)
# ════════════════════════════════════════════════════════════════════════════════
# No cache, no service — fully managed, index persists in Pinecone.
# Requires: OPENAI_API_KEY, PINECONE_API_KEY CI variables
# merlin.toml in repo root:
#   [rag]
#   enabled      = true
#   embedder     = "openai"
#   store        = "pinecone"
#   pinecone_host = "https://my-index-xyz.svc.us-east1.pinecone.io"
#
# merlin-review:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   script:
#     - merlin review
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     OPENAI_API_KEY: $OPENAI_API_KEY
#     PINECONE_API_KEY: $PINECONE_API_KEY
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ════════════════════════════════════════════════════════════════════════════════
# D) Ollama embeddings + local JSONL (fully private, no cloud APIs)
# ════════════════════════════════════════════════════════════════════════════════
# Requires: Docker-in-Docker runner (privileged: true)
# Ollama runs as a GitLab service; embeddings never leave your infra.
# merlin.toml in repo root:
#   [ai]
#   provider         = "ollama"          # use Ollama for code review too (optional)
#   ollama_base_url  = "http://ollama:11434"
#   model            = "codellama"
#
#   [rag]
#   enabled          = true
#   embedder         = "ollama"
#   store            = "local"
#   embed_model      = "nomic-embed-text"
#   ollama_base_url  = "http://ollama:11434"
#   local_path       = "merlin-rag.jsonl"
#
# merlin-review:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   services:
#     - name: ollama/ollama
#       alias: ollama
#   cache:
#     key: merlin-rag-$CI_DEFAULT_BRANCH
#     paths:
#       - merlin-rag.jsonl
#   before_script:
#     # Pull the embedding model into the Ollama service before indexing
#     - apk add --no-cache curl
#     - curl -fsSL http://ollama:11434/api/pull -d '{"name":"nomic-embed-text"}'
#   script:
#     - merlin review
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY   # still used for review if ai.provider = "anthropic"
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ════════════════════════════════════════════════════════════════════════════════
# E) No RAG (fastest — no embeddings, no vector store)
# ════════════════════════════════════════════════════════════════════════════════
# merlin.toml in repo root:
#   [rag]
#   enabled = false
#
# merlin-review:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   script:
#     - merlin review
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"

# ════════════════════════════════════════════════════════════════════════════════
# Optional: nightly re-index (keep RAG cache fresh)
# ════════════════════════════════════════════════════════════════════════════════
# Trigger from GitLab → CI/CD → Schedules (e.g. nightly at midnight).
# Works with any of the above store configurations.
#
# merlin-index:
#   stage: review
#   image: ghcr.io/arunachalamkalimuthu/merlin-ai-code-review:latest
#   cache:
#     key: merlin-rag-$CI_DEFAULT_BRANCH
#     paths:
#       - merlin-rag.jsonl
#   script:
#     - merlin rag index .
#   variables:
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     OPENAI_API_KEY: $OPENAI_API_KEY
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "schedule"

# ════════════════════════════════════════════════════════════════════════════════
# Optional: install-script alternative (no Docker)
# ════════════════════════════════════════════════════════════════════════════════
# Use if your runner cannot pull from GHCR.
# The musl binary is fully static — works on any Linux without glibc.
#
# merlin-review:
#   stage: review
#   image: alpine:3.20
#   cache:
#     - key: merlin-binary-$CI_RUNNER_ID
#       paths: [.merlin/]
#     - key: merlin-rag-$CI_DEFAULT_BRANCH
#       paths: [merlin-rag.jsonl]
#   before_script:
#     - apk add --no-cache curl ca-certificates
#     - |
#       if [ ! -x .merlin/merlin ]; then
#         mkdir -p .merlin
#         curl -fsSL \
#           https://github.com/Arunachalamkalimuthu/merlin-ai-code-review/releases/latest/download/install.sh \
#           | MERLIN_INSTALL_DIR=.merlin sh
#       fi
#   script:
#     - .merlin/merlin review
#   variables:
#     GITLAB_TOKEN: $CI_JOB_TOKEN
#     ANTHROPIC_API_KEY: $ANTHROPIC_API_KEY
#     OPENAI_API_KEY: $OPENAI_API_KEY
#   rules:
#     - if: $CI_PIPELINE_SOURCE == "merge_request_event"
