#!/usr/bin/env bash
# pre-push — runs security checks that mirror the CI security job.
#
# Checks run:
#   1. cargo audit   — known CVEs in dependencies (RustSec advisory DB)
#   2. cargo deny    — licence compliance + banned crates + duplicate deps
#
# These checks are on push (not commit) because they require network access
# to update the advisory database and can take 15–30 seconds.
#
# Install once:  bash scripts/install-hooks.sh
# Skip once:     git push --no-verify

set -euo pipefail

RED='\033[0;31m'
GRN='\033[0;32m'
YEL='\033[1;33m'
BLU='\033[0;34m'
RST='\033[0m'

PASS="${GRN}✔${RST}"
FAIL="${RED}✘${RST}"
INFO="${BLU}→${RST}"

echo ""
echo -e "${BLU}┌─────────────────────────────────────────┐${RST}"
echo -e "${BLU}│       Merlin pre-push security checks   │${RST}"
echo -e "${BLU}└─────────────────────────────────────────┘${RST}"
echo ""

ERRORS=0
MISSING=0

# ── Helper ────────────────────────────────────────────────────────────────────
run_check() {
    local label="$1"
    shift
    echo -e "${INFO} ${label}..."
    if output=$("$@" 2>&1); then
        echo -e "${PASS} ${label}"
    else
        echo -e "${FAIL} ${label}"
        echo ""
        echo -e "${RED}${output}${RST}"
        echo ""
        ERRORS=$((ERRORS + 1))
    fi
}

require_tool() {
    local tool="$1"
    local install_cmd="$2"
    if ! command -v "$tool" &>/dev/null; then
        echo -e "${YEL}⚠ ${tool} not installed — skipping${RST}"
        echo -e "  Install: ${install_cmd}"
        MISSING=$((MISSING + 1))
        return 1
    fi
    return 0
}

# ── 1. cargo audit — CVE check ────────────────────────────────────────────────
if require_tool cargo-audit "cargo install cargo-audit"; then
    run_check "cargo audit (CVE scan)" cargo audit --deny warnings
fi

# ── 2. cargo deny — licence + policy check ───────────────────────────────────
if require_tool cargo-deny "cargo install cargo-deny"; then
    run_check "cargo deny (licences + bans)" cargo deny check
fi

# ── Summary ───────────────────────────────────────────────────────────────────
echo ""
if [ "$MISSING" -gt 0 ]; then
    echo -e "${YEL}${MISSING} tool(s) missing — install them to enable full security checks.${RST}"
    echo -e "  Run: bash scripts/install-hooks.sh --tools"
    echo ""
fi

if [ "$ERRORS" -eq 0 ]; then
    echo -e "${GRN}All pre-push security checks passed.${RST}"
    echo ""
    exit 0
else
    echo -e "${RED}${ERRORS} security check(s) failed. Resolve the issues before pushing.${RST}"
    echo -e "${YEL}To skip hooks for an emergency push: git push --no-verify${RST}"
    echo ""
    exit 1
fi
